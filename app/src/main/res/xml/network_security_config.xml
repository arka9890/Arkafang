<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config>
        <domain includeSubdomains="false" cleartextTrafficPermitted="true">127.0.0.1</domain>
        <domain includeSubdomains="false" cleartextTrafficPermitted="true">localhost</domain>
    </domain-config>
</network-security-config>
