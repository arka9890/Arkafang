<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Plus Jakarta Sans font family. Weight mapping: 400 / 600 / 700 / 800. -->
    <!--
      The TTF files are placeholder stubs (empty). Real Plus Jakarta Sans TTFs
      must be copied manually into res/font/ — they are binary assets the agent
      cannot create. PastelClayTheme falls back to FontFamily.Default (sans-serif)
      until real TTFs are bundled, so the app will not crash without them.
    -->
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/plus_jakarta_sans_regular" />
    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/plus_jakarta_sans_medium" />
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/plus_jakarta_sans_bold" />
    <font
        android:fontStyle="normal"
        android:fontWeight="800"
        android:font="@font/plus_jakarta_sans_extrabold" />
</font-family>
